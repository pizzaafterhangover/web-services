---
import CategoryBadge from './CategoryBadge.astro';
import StatusLabel from './StatusLabel.astro';
import TagList from './TagList.astro';
import { formatDate, lastTouched, url, type Note } from '../lib/notes';

interface Props {
  notes: Note[];
  showCategory?: boolean;
}

const { notes, showCategory = true } = Astro.props;
---

<ol class="note-list">
  {
    notes.map((note) => (
      <li>
        <article>
          <div class="meta">
            {showCategory && <CategoryBadge id={note.data.category} />}
            <StatusLabel status={note.data.status} />
            <time datetime={lastTouched(note).toISOString()}>{formatDate(lastTouched(note))}</time>
          </div>
          <h3>
            <a href={url(`notes/${note.id}/`)}>{note.data.title}</a>
          </h3>
          <p>{note.data.description}</p>
          <TagList tags={note.data.tags} />
        </article>
      </li>
    ))
  }
</ol>

<style>
  .note-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px solid var(--border);
  }

  article {
    padding-block: var(--space-4);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  time {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin: var(--space-2) 0 var(--space-1);
    font-size: var(--text-lg);
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  p {
    margin: 0 0 var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>

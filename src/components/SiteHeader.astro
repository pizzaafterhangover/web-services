---
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../lib/notes';

interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: url('/'), label: '분류', match: (p: string) => p === url('/') || p.startsWith(url('categories/')) },
  { href: url('tags/'), label: '태그', match: (p: string) => p.startsWith(url('tags/')) },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')}>
      <span class="mark" aria-hidden="true"></span>
      {siteName}
    </a>
    <nav aria-label="주요 메뉴">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.match(path) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .mark {
    width: 0.875rem;
    height: 0.875rem;
    border: 2px solid var(--accent);
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px var(--surface), inset 0 0 0 6px var(--accent);
  }

  nav {
    margin-left: auto;
  }

  ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
    background: var(--surface-sunken);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    background: var(--surface-sunken);
  }
</style>

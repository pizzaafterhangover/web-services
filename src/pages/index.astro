---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryIndex from '../components/CategoryIndex.astro';
import NoteList from '../components/NoteList.astro';
import EmptyState from '../components/EmptyState.astro';
import { categories } from '../data/categories';
import { getNotes } from '../lib/notes';

const notes = await getNotes();
const recent = notes.slice(0, 8);
---

<BaseLayout>
  <header class="intro">
    <h1>Physical AI 노트</h1>
    <p>로봇이 세상을 보고, 위치를 알고, 움직이고, 배우는 방법을 공부하며 정리한 기록입니다.</p>
    <p class="stats">
      글 <strong>{notes.length}</strong>개 · 분류 <strong>{categories.length}</strong>개
    </p>
  </header>

  <section aria-labelledby="categories-title">
    <h2 id="categories-title" class="section-title">분류</h2>
    <CategoryIndex notes={notes} />
  </section>

  <section aria-labelledby="recent-title" class="recent">
    <h2 id="recent-title" class="section-title">최근 글</h2>
    {
      recent.length > 0 ? (
        <NoteList notes={recent} />
      ) : (
        <EmptyState title="아직 작성한 글이 없습니다">
          공부한 내용을 정리하면 여기에 최신순으로 나타납니다.
        </EmptyState>
      )
    }
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: var(--content-width);
    margin-bottom: var(--space-6);
  }

  h1 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl);
  }

  .intro p {
    margin: 0;
    color: var(--text-muted);
  }

  .intro .stats {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .stats strong {
    color: var(--text);
    font-family: var(--font-mono);
  }

  .recent {
    margin-top: var(--space-7);
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getNotes, url } from '../../lib/notes';

const notes = await getNotes();
const counts = new Map<string, number>();
for (const note of notes) {
  for (const tag of note.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ko'));
---

<BaseLayout title="태그">
  <h1>태그</h1>
  {
    tags.length > 0 ? (
      <ul class="tags">
        {tags.map(([tag, count]) => (
          <li>
            <a href={url(`tags/${encodeURIComponent(tag)}/`)}>
              #{tag} <span class="count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState title="아직 태그가 없습니다">글에 태그를 달면 여기에서 모아 볼 수 있습니다.</EmptyState>
    )
  }
</BaseLayout>

<style>
  h1 {
    margin: 0 0 var(--space-5);
    font-size: var(--text-2xl);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  a:hover {
    border-color: var(--accent);
  }

  .count {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
</style>
